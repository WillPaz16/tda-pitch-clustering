{"data":{"id":"10.2312/spbg/spbg07/091-100","type":"dois","attributes":{"doi":"10.2312/spbg/spbg07/091-100","prefix":"10.2312","suffix":"spbg/spbg07/091-100","identifiers":[],"alternateIdentifiers":[],"creators":[{"name":"Singh, Gurjeet","nameType":"Personal","givenName":"Gurjeet","familyName":"Singh","affiliation":[],"nameIdentifiers":[]},{"name":"Memoli, Facundo","nameType":"Personal","givenName":"Facundo","familyName":"Memoli","affiliation":[],"nameIdentifiers":[]},{"name":"Carlsson, Gunnar","nameType":"Personal","givenName":"Gunnar","familyName":"Carlsson","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Topological Methods for the Analysis of High Dimensional Data Sets and 3D Object Recognition"}],"publisher":"The Eurographics Association","container":{"type":"Series","identifier":"1811-7813","identifierType":"ISSN","title":"Eurographics Symposium on Point-Based Graphics"},"publicationYear":2007,"subjects":[{"subject":"Categories and Subject Descriptors (according to ACM CCS): I.3.5 [Computer Graphics]: Computational Geometry and Object Modelling."}],"contributors":[],"dates":[{"date":"2007","dateType":"Issued"}],"language":"en","types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork"},"relatedIdentifiers":[{"relationType":"IsPartOf","relatedIdentifier":"1811-7813","relatedIdentifierType":"ISSN"},{"relationType":"IsPartOf","relatedIdentifier":"978-3-905673-51-7","relatedIdentifierType":"ISBN"},{"relationType":"IsOriginalFormOf","relatedIdentifier":"http://diglib.eg.org/EG/DL/WS/SPBG/SPBG07/091-100.pdf","relatedIdentifierType":"URL"}],"relatedItems":[],"sizes":["10 pages"],"formats":[],"version":null,"rightsList":[],"descriptions":[{"description":"Eurographics Symposium on Point-Based Graphics","descriptionType":"SeriesInformation"},{"description":"We present a computational method for extracting simple descriptions of high dimensional data sets in the form of simplicial complexes. Our method, called Mapper, is based on the