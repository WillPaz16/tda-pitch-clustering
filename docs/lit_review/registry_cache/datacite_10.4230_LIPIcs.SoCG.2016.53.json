{"data":{"id":"10.4230/lipics.socg.2016.53","type":"dois","attributes":{"doi":"10.4230/lipics.socg.2016.53","prefix":"10.4230","suffix":"lipics.socg.2016.53","identifiers":[{"identifier":"urn:nbn:de:0030-drops-59454","identifierType":"URN"}],"alternateIdentifiers":[{"alternateIdentifierType":"URN","alternateIdentifier":"urn:nbn:de:0030-drops-59454"}],"creators":[{"name":"Munch, Elizabeth","nameType":"Personal","givenName":"Elizabeth","familyName":"Munch","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Bei","nameType":"Personal","givenName":"Bei","familyName":"Wang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"lang":"en","title":"Convergence between Categorical Representations of Reeb Space and Mapper"}],"publisher":"Schloss Dagstuhl – Leibniz-Zentrum für Informatik","container":{"type":"Series","identifier":"10.4230/LIPIcs.SoCG.2016","identifierType":"DOI","title":"LIPIcs, Volume 51, SoCG 2016","volume":"51","number":"53","firstPage":"53:1","lastPage":"53:16"},"publicationYear":2016,"subjects":[{"lang":"en","subject":"Topological data analysis"},{"lang":"en","subject":"Reeb space"},{"lang":"en","subject":"mapper"},{"lang":"en","subject":"category theory"}],"contributors":[{"name":"Fekete, Sándor","nameType":"Personal","givenName":"Sándor","familyName":"Fekete","contributorType":"Editor","affiliation":[],"nameIdentifiers":[]},{"name":"Lubiw, Anna","nameType":"Personal","givenName":"Anna","familyName":"Lubiw","contributorType":"Editor","affiliation":[],"nameIdentifiers":[]}],"dates":[{"date":"2016","dateType":"Issued"},{"date":"2016-06-10","dateType":"Available"},{"date":"2016-06-10","dateType":"Created"},{"date":"2016-06-10","dateType":"Copyrighted"}],"language":"en","types":{"ris":"CPAPER","bibtex":"inproceedings","citeproc":"","schemaOrg":"Article","resourceTypeGeneral":"ConferencePaper"},"relatedIdentifiers":[{"relationType":"IsPartOf","relatedIdentifier":"10.4230/LIPIcs.SoCG.2016","relatedIdentifierType":"DOI"},{"relationType":"IsPartOf","relatedIdentifier":"978-3-95977-009-5","relatedIdentifierType":"ISBN"},{"relationType":"IsPartOf","relatedIdentifier":"1868-8969","relatedIdentifierType":"ISSN"}],"relatedItems":[{"number":"53","titles":[{"title":"LIPIcs, Volume 51, SoCG 2016"},{"title":"32nd International Symposium on Computational Geometry (SoCG 2016)","titleType":"Subtitle"}],"volume":"51","lastPage":"53:16","firstPage":"53:1","publisher":"Schloss Dagstuhl – Leibniz-Zentrum für Informatik","contributors":[{"name":"Fekete, Sándor","nameType":"Personal","givenName":"Sándor","familyName":"Fekete","contributorType":"Editor"},{"name":"Lubiw, Anna","nameType":"Personal","givenName":"Anna","familyName":"Lubiw","contributorType":"Editor"}],"relationType":"IsPublishedIn","publicationYear":"2016","relatedItemType":"ConferenceProceeding","relatedItemIdentifier":{"relatedItemIdentifier":"10.4230/LIPIcs.SoCG.2016","relatedItemIdentifierType":"DOI"}},{"titles":[{"title":"Leibniz International Proceedings in Informatics (LIPIcs)"}],"volume":"51","publisher":"Schloss Dagstuhl – Leibniz-Zentrum für Informatik","relationType":"IsPublishedIn","publicationYear":"2016","relatedItemType":"Collection","relatedItemIdentifier":{"relatedItemIdentifier":"1868-8969","relatedItemIdentifierType":"ISSN"}}],"sizes":["16 pages","774174 bytes"],"formats":["application/pdf"],"version":null,"rightsList":[{"lang":"en","rights":"Creative Commons Attribution 3.0 Unported license","rightsUri":"https://creativecommons.org/licenses/by/3.0/legalcode","rightsIdentifier":"cc by 3.0"},{"rights":"info:eu-repo/semantics/openAccess"}],"descriptions":[{"lang":"en","description":"The Reeb space, which generalizes the notion of a Reeb graph, is one of the few tools in topological data analysis and visualization suitable for the study of multivariate scientific datasets. First introduced by Edelsbrunner et al., it compresses the components of the level sets of a multivariate mapping and obtains a summary representation of their relationships. A related construction called mapper, and a special case of the mapper construction called the Joint Contour Net have been shown to be effective in visual analytics. Mapper and JCN are intuitively regarded as discrete approximations of the Reeb space, however without formal proofs or approximation guarantees. An open question has been proposed by Dey et al. as to whether the mapper construction converges to the Reeb space in the limit. \r\n\r\nIn this paper, we are interested in developing the theoretical understanding of the relationship between the Reeb space and its discrete approximations to support its use in practical data analysis. Using tools from category theory, we formally prove the convergence between the Reeb space and mapper in terms of an interleaving distance between their categorical representations. Given a sequence of refined discretizations, we prove that these approximations converge to the Reeb space in the interleaving distance; this also helps to quantify the approximation quality of the discretization at a fixed resolution.","descriptionType":"Abstract"},{"lang":"en","description":"LIPIcs, Vol. 51, 32nd International Symposium on Computational Geometry (SoCG 2016), pages 53:1-53:16","descriptionType":"SeriesInformation"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://drops.dagstuhl.de/entities/document/10.4230/LIPIcs.SoCG.2016.53","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"api","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":1,"citationsOverTime":[{"year":"2026","total":1}],"partCount":0,"partOfCount":1,"versionCount":0,"versionOfCount":0,"created":"2016-06-10T16:23:16.000Z","registered":"2016-06-10T16:23:16.000Z","published":"2016","updated":"2023-12-21T12:17:41.000Z"},"relationships":{"client":{"data":{"id":"lzi.drops","type":"clients"}},"provider":{"data":{"id":"lzi","t